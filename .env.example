# Скопируй этот файл в .env и заполни

# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID организаторов через запятую (узнать свой: напиши боту /myid)
ADMIN_IDS=111111111

# Файл базы данных (можно не трогать)
DB_PATH=zhabilizacia.db

# Часовой пояс для напоминаний в 18:00 (используется в Docker)
TZ=Europe/Moscow
